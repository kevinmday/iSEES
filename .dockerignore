# Deny unrelated and private repository surfaces.
.git
.git/**
.agents
.codex

# MarketMind is categorically outside the image and build surface (explicit families).
marketmind_engine
marketmind_engine/**
marketmind_flask
marketmind_flask/**
marketmind_LEGACY_READONLY
marketmind_LEGACY_READONLY/**
MarketMindAI_ARCHIVE
MarketMindAI_ARCHIVE/**
**/[Mm][Aa][Rr][Kk][Ee][Tt][Mm][Ii][Nn][Dd]*/**

# Backups, discoveries, patches, pasted material, screenshots, and archives.
**/backup
**/backups
**/dev-backup
**/dev-backups
**/*BACKUP*
**/*backup*
**/*discovery*
**/*.patch
**/*.diff
**/*.bak
**/*.txt
!isees_uap/requirements.txt
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.zip
**/*.tar
**/*.tar.gz
**/*.7z

# Dependencies, generated builds, caches, tests, and local tooling.
**/node_modules
**/dist
**/build
**/.vite
**/.cache
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/coverage
**/htmlcov
**/testing
**/tests
legacy_tests
scripts
docs
regime_ui
runtime

# Runtime state, outputs, logs, databases, and secrets.
/runtime/**
**/outputs/**
**/*.log
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.sqlite-wal
**/*.sqlite-shm
**/*.sqlite3-wal
**/*.sqlite3-shm
.env
.env.*
**/.env
**/.env.*
# File-oriented credentials and runtime secrets. Do not filter source modules by
# domain words such as "token", "authentication", "key", or "secret".
**/.credential
**/.credential.*
**/.credentials
**/.credentials.*
**/credential.json
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/credentials.toml
**/*.credential
**/*.credentials
**/.token
**/.token.*
**/hf_token
**/hf_token.*
**/huggingface_token
**/huggingface_token.*
**/*.secret
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/secrets.toml
**/*.pem
**/*.key

# Root material not copied by the explicit Dockerfile remains excluded defensively.
*.ps1
*.py
*.jsonl
*.html
